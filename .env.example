# Everything is optional. With nothing set, the app uses an embedded PGlite
# database in ./.data/pglite and deterministic mock providers.

# Postgres (Neon in production). Leave empty to use PGlite.
DATABASE_URL=

# PGlite data directory (used only when DATABASE_URL is empty).
PGLITE_DIR=./.data/pglite

# Auth.js secret. Required in production. Generate with: openssl rand -base64 32
AUTH_SECRET=dev-only-secret-change-me
AUTH_TRUST_HOST=true

# Protects /api/cron/tick. Vercel Cron sends "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=dev-cron-secret

# Comma separated emails that may use /admin. In dev, any signed-in user may.
ADMIN_EMAILS=

# Optional: real LLM. When unset the deterministic MockProvider is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: override game config defaults with a JSON file (deep-merged, zod validated).
GAME_CONFIG_PATH=

# Optional: season seed for a fresh world (the seed script uses a fixed default).
SEASON_SEED=
